# ============================================================
# Painel — copie para .env.local (local) ou cole em
# Vercel → Settings → Environment Variables (produção).
#
# NEXT_PUBLIC_ é literal: as duas variáveis vão para dentro do bundle e
# qualquer pessoa lê no devtools. Está certo — a anon key foi feita para isso,
# e quem protege os dados é a RLS, não o sigilo da chave.
#
# NÃO existe SUPABASE_SERVICE_ROLE_KEY aqui. Ela ignora RLS no banco inteiro e
# vive só no worker/.env, na sua máquina. Colar a service_role em qualquer uma
# das linhas abaixo publicaria acesso irrestrito ao banco na primeira request.
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional. Só é usada quando não há header de host — o normal é a origem sair
# do próprio request, para o magic link funcionar em localhost, em preview da
# Vercel e em produção sem trocar nada.
# NEXT_PUBLIC_SITE_URL=https://seu-painel.vercel.app
