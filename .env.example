# ============================================================
# ATMOSFERA PIPELINE — variáveis de ambiente
# Copie para worker/.env e preencha. NUNCA commitar o .env real.
# ============================================================

# ---------- Supabase ----------
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# service_role IGNORA RLS por design. Só no worker, só no PC local.
# Se essa chave chegar no painel ou na Vercel, o multi-tenant morreu.
SUPABASE_SERVICE_ROLE_KEY=

# org_id do tenant deste worker (uuid) — casa com app_metadata.org_id do JWT
ORG_ID=

# ---------- MoneyPrinterTurbo (Docker local) ----------
MPT_API_URL=http://127.0.0.1:8080
MPT_TIMEOUT_SEG=1200

# ---------- YouTube Data API v3 ----------
# OAuth desktop flow — o token.json é gerado na primeira execução e fica local.
YOUTUBE_CLIENT_SECRET_PATH=./client_secret.json
YOUTUBE_TOKEN_PATH=./token.json
# Teto de cota: 10.000 un/dia ÷ 1.600 por upload ≈ 6 vídeos/dia
YOUTUBE_MAX_UPLOADS_DIA=6

# ---------- TikTok Content Posting API ----------
# Escopo video.upload (inbox/rascunho) — NÃO direct post.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ---------- Worker ----------
WORKER_POLL_SEG=30
WORKER_ORFAOS_MINUTOS=45
OUTPUT_DIR=./output

# ============================================================
# PAINEL (Next.js / Vercel) — copie para painel/.env.local
# Só a chave anon. O RLS faz o resto.
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
