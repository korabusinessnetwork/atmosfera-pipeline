# === SEGREDOS — nunca versionar ===
# ATENÇÃO: o .gitignore NÃO aceita comentário no fim da linha. O `#` só abre
# comentário na coluna 1; no meio da linha ele vira parte do padrão. As duas
# linhas abaixo já tiveram comentário à direita e por isso não casavam com
# arquivo nenhum — `git check-ignore -v worker/token.json` não devolvia nada.
.env
.env.*
!.env.example
# OAuth do YouTube (gravado por worker/autorizar_youtube.py)
token.json
# OAuth do TikTok (gravado por worker/autorizar_tiktok.py). Precisa de linha
# própria: o padrão `token.json` acima casa nome de arquivo inteiro, não sufixo.
tiktok_token.json
*.token
# credenciais do Google Cloud (baixadas do console)
client_secret*.json

# === Saída de render (é vídeo, não é código) ===
output/
*.mp4
*.mov
*.webm
*.mkv

# === MoneyPrinterTurbo (vem do Docker, não é nosso código) ===
MoneyPrinterTurbo/

# === Python (worker) ===
__pycache__/
*.py[cod]
.venv/
venv/
.uv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# === Node / Next.js (painel) ===
node_modules/
.next/
out/
dist/
.vercel/

# === Supabase CLI ===
.supabase/
supabase/.temp/

# === Logs ===
*.log
npm-debug.log*
logs/

# === Editores / SO ===
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# === Cache / cobertura ===
.cache/
coverage/
